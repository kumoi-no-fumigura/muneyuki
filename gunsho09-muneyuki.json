  {
   "id": "gunsho09-muneyuki-0002",
   "pid": "1879517",
   "pages": [
    298
   ],
   "text": "貫之が許にひさしうおとせぬにせうそこいひつかはすとて君ひとりさひこめからに我やとの道も露けく成にけるかなかへし草の露おきしもあへす朝夕に心かよはぬ時しなけれはひさしくたいめせぬころ貫之がもとよりよそにても思ふ心は變らねとあひみぬ時はこひしかりけりかへし櫻ちりうの花もみな咲ぬれと心さしには春夏もなし貫之がもとへよの中に誰かなたかにたらちねと我とかなとか人はしるらんかへし君はいさわれか思ひは白雲のかゝる山にもおとらさらまし",
   "poems": [
    "35",
    "36",
    "37",
    "38",
    "39",
    "40"
   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "東路のさよの中山なか〓〓に逢みて後そわひしかりける",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "つれもなく成行人の〓とのはや秋よりさきの紅葉なるらん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "わすれ草枯もやするとつれもなき人の心に霜はおかなん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "いつはとは時はわかねと秋のよそ物思ふ比の限りなりける",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "我こひの數にしとらは白妙の濵の眞砂もつきぬへらなり",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "恨むれとこふれと君かよとゝもにしらす顔にて難面かるらん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "思ふともこふともいかゝ雲ゐよりはるけき人の空にしるらん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "あはすして今夜あけなは春のひの長くや人をつらしと思はん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "ときはなる松のみとりも春くれは今一しほの色まさりけり",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "雪ふりて年のくれぬる時にこそつひにもみちぬ松もみえけれ",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "袖ぬれて別はすとも唐衣ゆくとないひそきたりとをみん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "別ちは心もゆかすから衣きれは涙はさきにたちつゝ",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "そへてやる扇のかせの心あらは我思ふ人の手をなはなれそ",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "今はとて別るゝ時は天の川わたらぬさきに袖そぬれぬる",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "山里は冬そさひしさまさりける人めも草もかれぬとおもへは",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "けふ人をこふる心はあすか川なかるゝ水におとらさりけり",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "いかて猶かさとり山にみをなして露けき旅にそはんとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "かさとりの山と賴みし君をおきて涙の雨にぬれつゝそ行",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "君か行かたにありてふ淚川水は底にそなかるへらなる",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "秋の野にやとりはすへし女郞花名をむつましみ旅ならなくに",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "人を思ふ心は我にあらねはやみのまとふたにしられさるらん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "わかやとの庭の秋はき散にけり後みむ人やくやしとおもはむ",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "梓弓いるさの山の秋きりのあたる〓とにや色まさるらん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "しら露のおかまくをしき秋萩ををりては更におきやまさらん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "よそにしてこふれは苦しいれ組のおなし心にいさ結ひてん",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "君といへはみまれみすまれふしの根の珍しけなくもゆる我戀",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "君とわかいもせの山の秋くれは色變りぬる物にそありける",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "我妹子に逢坂山のしのすゝきほにはいてすも戀わたるかな",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "年月は昔にもあらす成ぬれとこひしき事はかはらさりけり",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "ゆき積るおのか年をばしらすして春をはあすと聞そ嬉しき",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "朝またき露分きつる衣手のひるまはかりの戀しきやなそ",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "よの人のおよひかたきは富士のねの麓にたかき思なりけり",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "あけかたに外山の雲のいとはれて歸りしほとは侘しかりきや",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "くる春にあはむと社かたからめ過行たひに遲れすもかな",
   "kana": "",
   "speaker": "",
   "page": 297,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "君ひとりとひこめからに我やとの道も露けく成にけるかな",
   "kana": "",
   "speaker": "公忠朝臣集",
   "page": 298,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "草の露おきしもあへす朝夕に心かよはぬ時しなけれは",
   "kana": "",
   "speaker": "",
   "page": 298,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "よそにても思ふ心は變らねとあひみぬ時はこひしかりけり",
   "kana": "",
   "speaker": "",
   "page": 298,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "櫻ちりうの花もみな咲ぬれと心さしには春夏もなし",
   "kana": "",
   "speaker": "",
   "page": 298,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "よの中に誰かなたかにたらちねと我とかなとか人はしるらん",
   "kana": "",
   "speaker": "",
   "page": 298,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "君はいさわれか思ひは白雲のかゝる山にもおとらさらまし",
   "kana": "",
   "speaker": "",
   "page": 298,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
